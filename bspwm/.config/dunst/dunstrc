[global]
monitor = 0
follow = mouse
width = 320
height = 90
origin = top-right
offset = 24x24
padding = 10
horizontal_padding = 12
frame_width = 2
separator_height = 0
font = JetBrainsMono Nerd Font 10
markup = yes
format = "<b>%s</b>\n%b"
alignment = left
word_wrap = yes
corner_radius = 6
show_age_threshold = 60
idle_threshold = 120
history_length = 20
mouse_left_click = close_current
mouse_right_click = close_all
timeout = 2

[urgency_low]
timeout = 2
background = "#1e1e2e"
foreground = "#cdd6f4"
frame_color = "#6c7086"

[urgency_normal]
timeout = 3
background = "#1e1e2e"
foreground = "#cdd6f4"
frame_color = "#89b4fa"

[urgency_critical]
timeout = 0
background = "#1e1e2e"
foreground = "#f38ba8"
frame_color = "#f38ba8"

