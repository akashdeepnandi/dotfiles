[global]
icon_position = left
icon_path = /usr/share/icons/Papirus-Dark/48x48/status:/usr/share/icons/Papirus/48x48/apps
enable_recursive_icon_lookup = true
monitor = -1
follow = mouse
padding = 10
horizontal_padding = 12
frame_width = 2
separator_height = 5
separator_color = "#00000000"
font = JetBrainsMono Nerd Font 10
markup = yes
format = "<b>%s</b>\n%b"
alignment = left
word_wrap = yes
corner_radius = 6
show_age_threshold = 60
idle_threshold = 120
history_length = 20
mouse_left_click = close_current
mouse_right_click = close_all
timeout = 2
geometry = "320x0-16+16"
icon_position = left
max_icon_size = 32

[urgency_low]
timeout = 2
background = "#1e1e2e"
foreground = "#cdd6f4"
frame_color = "#6c7086"

[urgency_normal]
timeout = 3
background = "#1e1e2e"
foreground = "#cdd6f4"
frame_color = "#1e1e2e"

[urgency_critical]
timeout = 0
background = "#1e1e2e"
foreground = "#f38ba8"
frame_color = "#1e1e2e"

